# Copy this file to .env and fill in your Foundry project details.
# Find these in your Microsoft Foundry project's Overview page.
AZURE_AI_PROJECT_ENDPOINT=yourazureprojectendpoint
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Auth uses AzureCliCredential — run `az login` in your terminal before running
# the app, no key needs to go in this file.

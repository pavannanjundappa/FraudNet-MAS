# Copy this file to .env and fill in your Foundry project details.
# Replace these values with your own project endpoint and deployment name.
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource-name>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<your-model-deployment-name>

# Auth uses AzureCliCredential — run `az login` in your terminal before running
# the app, no key needs to go in this file.
